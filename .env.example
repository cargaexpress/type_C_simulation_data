# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL credentials (required by docker-compose.seed.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cargaexpress

# Async connection URL for local seeder execution (wms-seed / seed_wms.py)
# In Docker Compose, this is automatically built using the 'db' service host
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cargaexpress

# =============================================================================
# ENVIRONMENT & SECURITY GUARDS
# =============================================================================
# Runtime environment (seeder refuses 'prod' or 'production' for safety)
APP_ENV=development

# Explicitly allow running the seeder against a remote database host (true | false)
SEED_ALLOW_REMOTE=false

# =============================================================================
# WMS SEEDER CONFIGURATION (simulators.seed)
# =============================================================================
# Volume profile:
# - dev : 3 days x 200 orders per day (600 orders)
# - full: 7 days x 15000 orders per day (105,000 orders)
SEED_PROFILE=dev

# Optional overrides for day count and daily order volume (leave empty to use SEED_PROFILE defaults)
SEED_DAYS=
SEED_ORDERS_PER_DAY=

# Initial date for order generation in ISO format (YYYY-MM-DD)
SEED_START_DATE=2026-10-01

# Integer seed to ensure deterministic reproducibility
SEED_RANDOM_SEED=42

# =============================================================================
# SEEDED BRAND API KEYS (required by docker-compose.seed.yml for the backend)
# =============================================================================
SEED_BRAND_KEY_1=dev-brand-1-api-key
SEED_BRAND_KEY_2=dev-brand-2-api-key
SEED_BRAND_KEY_3=dev-brand-3-api-key
